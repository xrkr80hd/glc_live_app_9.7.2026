# ── Go Liberty Church — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Go Liberty Church"
APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_PROVIDER_URL=

# ── Media / Storage ───────────────────────────────────────────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Giving / Payments ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@golibertychurch.app

# ── Analytics ─────────────────────────────────────────────────────────────────
ANALYTICS_ID=

# ── Social / Streaming ───────────────────────────────────────────────────────
YOUTUBE_CHANNEL_ID=
FACEBOOK_PAGE_ID=
